      "description": "Shared subtle action treatment.",
      "html": "<button class=\"ds-subtle\">Open a plan</button>",
      "css": ".ds-subtle{padding:10px 17px;min-height:44px;border:1px solid var(--line);border-radius:var(--control-radius);font:600 14px/1.4 var(--sans);transition:background 180ms var(--ease),color 180ms var(--ease),border-color 180ms var(--ease);background:transparent;color:var(--ink);cursor:pointer}.ds-subtle:hover{background:transparent;border-color:#95a58e}.ds-subtle:focus-visible{outline:2px solid var(--green);outline-offset:3px}.ds-subtle:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-subtle{transition:none}}",
      "refersTo": "button-subtle"
    },
    {
