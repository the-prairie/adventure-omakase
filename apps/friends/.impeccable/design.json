  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "description": "Shared primary action treatment.",
      "html": "<button class=\"ds-primary\">Open a plan</button>",
      "css": ".ds-primary{padding:10px 17px;min-height:44px;border:1px solid var(--green);border-radius:var(--control-radius);font:600 14px/1.4 var(--sans);transition:background 180ms var(--ease),color 180ms var(--ease),border-color 180ms var(--ease);background:var(--green);color:white;cursor:pointer}.ds-primary:hover{background:#375c45;border-color:var(--green)}.ds-primary:focus-visible{outline:2px solid var(--green);outline-offset:3px}.ds-primary:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "description": "Shared secondary action treatment.",
      "html": "<button class=\"ds-secondary\">Open a plan</button>",
      "css": ".ds-secondary{padding:10px 17px;min-height:44px;border:1px solid var(--line);border-radius:var(--control-radius);font:600 14px/1.4 var(--sans);transition:background 180ms var(--ease),color 180ms var(--ease),border-color 180ms var(--ease);background:var(--white);color:var(--ink);cursor:pointer}.ds-secondary:hover{background:#eff0e7;border-color:#95a58e}.ds-secondary:focus-visible{outline:2px solid var(--green);outline-offset:3px}.ds-secondary:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}",
      "refersTo": "button-secondary"
    },
    {
