{
  "name": "@adventure-omakase/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/app.test.ts test/environment.test.ts",
    "test:integration": "vitest run test/database.integration.test.ts",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@adventure-omakase/contracts": "workspace:*",
    "@adventure-omakase/db": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "pino-pretty": "13.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
