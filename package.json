{
  "name": "adventure-omakase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --parallel",
    "dev:api": "dotenv -e .env -- turbo run dev --filter @adventure-omakase/api",
    "dev:studio": "dotenv -e .env -- turbo run dev --filter @adventure-omakase/studio",
    "dev:mobile": "dotenv -e .env -- turbo run dev --filter @adventure-omakase/mobile",
    "build": "dotenv -e .env -- turbo run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "dotenv -e .env -- turbo run test:integration",
    "test:e2e": "dotenv -e .env -- playwright test",
    "test:e2e:production": "bash scripts/production-smoke.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "infra:up": "docker compose up -d --wait db",
    "infra:down": "docker compose down --remove-orphans",
    "infra:logs": "docker compose logs -f db",
    "db:generate": "dotenv -e .env -- pnpm --filter @adventure-omakase/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @adventure-omakase/db migrate",
    "db:check": "dotenv -e .env -- pnpm --filter @adventure-omakase/db check",
    "mobile:doctor": "dotenv -e .env -- pnpm --filter @adventure-omakase/mobile run doctor",
    "mobile:export": "dotenv -e .env -- pnpm --filter @adventure-omakase/mobile export",
    "doctor": "tsx scripts/doctor.ts",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
