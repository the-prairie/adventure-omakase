# Runtime identity
NODE_ENV=development
APP_VERSION=0.0.0
GIT_SHA=local
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000

# Studio server-to-server API boundary. Never expose this through NEXT_PUBLIC_.
API_BASE_URL=http://localhost:4000
API_REQUEST_TIMEOUT_MS=5000

# Local PostGIS only. Replace all credentials outside local development.
POSTGRES_DB=adventure_omakase
POSTGRES_USER=adventure_omakase
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=54320
DATABASE_URL=postgresql://adventure_omakase:local_development_only@localhost:54320/adventure_omakase

# Public mobile configuration. Never place server credentials in public variables.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Reserved production integration boundaries. Not required by the bootstrap tracer.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
