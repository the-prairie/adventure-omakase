{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.example", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "APP_VERSION", "GIT_SHA"],
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "API_BASE_URL",
        "API_CORS_ORIGINS",
        "API_HOST",
        "API_PORT",
        "API_REQUEST_TIMEOUT_MS",
        "DATABASE_URL",
        "EXPO_PUBLIC_API_BASE_URL",
        "LOG_LEVEL"
      ],
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["EXPO_PUBLIC_API_BASE_URL"],
      "inputs": ["$TURBO_DEFAULT$", "!.env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "web-build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
